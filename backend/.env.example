# Default provider: Groq (OpenAI-compatible API)
# Create a free API key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional provider settings. Leave these commented out to use the Groq defaults.
# LLM_API_KEY=replace_with_provider_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

PORT=5000
